apiVersion: v1
kind: Pod
metadata:
  name: "@@PRELOAD_NAME@@"
  namespace: nim-fast-start
  labels:
    app.kubernetes.io/name: proteinmpnn
    app.kubernetes.io/component: response-requalification-image-preload
    archvteams.nebius.ai/batch-id: "@@BATCH_ID@@"
spec:
  automountServiceAccountToken: false
  enableServiceLinks: false
  restartPolicy: Never
  nodeSelector:
    kubernetes.io/hostname: "@@TARGET_NODE@@"
  imagePullSecrets:
    - name: "@@NGC_PULL_SECRET@@"
    - name: "@@WORKER_PULL_SECRET@@"
  containers:
    - name: target
      image: "@@TARGET_IMAGE@@"
      imagePullPolicy: IfNotPresent
      command: [/bin/true]
      resources:
        requests: {cpu: 10m, memory: 16Mi}
        limits: {cpu: 100m, memory: 64Mi}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
        readOnlyRootFilesystem: true
        runAsUser: 0
    - name: restore-worker
      image: "@@WORKER_IMAGE@@"
      imagePullPolicy: IfNotPresent
      command: [/bin/true]
      resources:
        requests: {cpu: 10m, memory: 16Mi}
        limits: {cpu: 100m, memory: 64Mi}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
        readOnlyRootFilesystem: true
        runAsUser: 0
    - name: semantic-probe
      image: "@@PROBE_IMAGE@@"
      imagePullPolicy: IfNotPresent
      command: [/bin/true]
      resources:
        requests: {cpu: 10m, memory: 16Mi}
        limits: {cpu: 100m, memory: 64Mi}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
        readOnlyRootFilesystem: true
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
