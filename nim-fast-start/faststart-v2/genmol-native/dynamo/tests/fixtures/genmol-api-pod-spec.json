{
  "affinity": {
    "nodeAffinity": {
      "requiredDuringSchedulingIgnoredDuringExecution": {
        "nodeSelectorTerms": [
          {
            "matchExpressions": [
              {
                "key": "kubernetes.io/hostname",
                "operator": "In",
                "values": [
                  "gpu-node-b.example.invalid"
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "automountServiceAccountToken": false,
  "containers": [
    {
      "args": [
        "2147483647"
      ],
      "command": [
        "/bin/sleep"
      ],
      "env": [
        {
          "name": "DYN_SNAPSHOT_RESTORE_STANDBY",
          "value": "1"
        },
        {
          "name": "DYN_SNAPSHOT_CONTROL_DIR",
          "value": "/snapshot-control"
        },
        {
          "name": "NIM_CACHE_PATH",
          "value": "/opt/nim/.cache"
        }
      ],
      "image": "nvcr.io/nim/nvidia/genmol@sha256:139b909a450fe1fb81198214784a15f67e172e766a93a1569827ba5aa05b4541",
      "imagePullPolicy": "IfNotPresent",
      "name": "genmol",
      "ports": [
        {
          "containerPort": 8000,
          "name": "http",
          "protocol": "TCP"
        }
      ],
      "readinessProbe": {
        "failureThreshold": 3,
        "httpGet": {
          "path": "/v1/health/ready",
          "port": "http"
        },
        "periodSeconds": 1,
        "timeoutSeconds": 1
      },
      "resources": {
        "limits": {
          "cpu": "12",
          "memory": "128Gi",
          "nvidia.com/gpu": "1"
        },
        "requests": {
          "cpu": "11",
          "memory": "120Gi",
          "nvidia.com/gpu": "1"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "privileged": false,
        "runAsGroup": 0,
        "runAsUser": 0
      },
      "startupProbe": {
        "exec": {
          "command": [
            "/bin/test",
            "-f",
            "/snapshot-control/restore-complete"
          ]
        },
        "failureThreshold": 1800,
        "periodSeconds": 1,
        "timeoutSeconds": 1
      },
      "volumeMounts": [
        {
          "mountPath": "/dev/shm",
          "name": "dshm"
        },
        {
          "mountPath": "/opt/nim/.cache",
          "name": "nim-cache",
          "readOnly": true
        },
        {
          "mountPath": "/opt/nim/workspace",
          "name": "workspace"
        },
        {
          "mountPath": "/output",
          "name": "output"
        },
        {
          "mountPath": "/snapshot-control",
          "name": "snapshot-control",
          "subPath": "genmol"
        },
        {
          "mountPath": "/checkpoints",
          "name": "checkpoints",
          "readOnly": true
        }
      ]
    }
  ],
  "dnsPolicy": "ClusterFirst",
  "enableServiceLinks": false,
  "nodeName": "gpu-node-b.example.invalid",
  "restartPolicy": "Never",
  "runtimeClassName": "nvidia",
  "schedulerName": "default-scheduler",
  "securityContext": {
    "seccompProfile": {
      "localhostProfile": "profiles/block-iouring.json",
      "type": "Localhost"
    }
  },
  "serviceAccountName": "default",
  "volumes": [
    {
      "emptyDir": {
        "medium": "Memory",
        "sizeLimit": "16Gi"
      },
      "name": "dshm"
    },
    {
      "name": "nim-cache",
      "persistentVolumeClaim": {
        "claimName": "genmol-nim-cache",
        "readOnly": true
      }
    },
    {
      "emptyDir": {
        "sizeLimit": "8Gi"
      },
      "name": "workspace"
    },
    {
      "emptyDir": {
        "sizeLimit": "1Gi"
      },
      "name": "output"
    },
    {
      "emptyDir": {
        "sizeLimit": "16Mi"
      },
      "name": "snapshot-control"
    },
    {
      "name": "checkpoints",
      "persistentVolumeClaim": {
        "claimName": "genmol-native-artifacts",
        "readOnly": true
      }
    }
  ]
}
