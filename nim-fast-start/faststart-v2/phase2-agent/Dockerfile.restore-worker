# syntax=docker/dockerfile:1
#
# Pinned compiler/export stage for the one-shot worker. Build from the root of
# a clean f7f37be tree after materialize_overlay.sh has installed the overlay.
# The scratch output is a binary artifact, not the runnable restore image; the
# patched upstream deploy/snapshot/Dockerfile copies the same binary into the
# CUDA/CRIU agent runtime that carries /snapshot-binaries.
ARG GO_IMAGE=golang:1.26.3-bookworm@sha256:386d475a660466863d9f8c766fec64d7fdad3edac2c6a05020c09534d71edb4b
FROM ${GO_IMAGE} AS build

ARG DYNAMO_COMMIT=f7f37be174d252590c4b56e25ff4262dd82466fd
RUN test "${DYNAMO_COMMIT}" = "f7f37be174d252590c4b56e25ff4262dd82466fd"

COPY deploy/operator/ /operator/
COPY deploy/snapshot/ /workspace/
WORKDIR /workspace

RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -buildvcs=false -ldflags="-w -s" \
    -o /out/restore-worker ./cmd/restore-worker

FROM scratch AS restore-worker-binary
LABEL org.opencontainers.image.source="https://github.com/ai-dynamo/dynamo" \
      org.opencontainers.image.revision="f7f37be174d252590c4b56e25ff4262dd82466fd" \
      org.opencontainers.image.archvteams.role="one-shot-restore-worker-binary"
COPY --from=build /out/restore-worker /restore-worker
