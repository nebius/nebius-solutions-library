@@ -171,2 +171,9 @@ func ApplyRootfsDiff(checkpointPath, targetRoot string, log logr.Logger) error {
-	log.Info("Applying rootfs diff", "target", targetRoot)
-	cmd := exec.Command("tar", "--skip-old-files", "-C", targetRoot, "-xf", rootfsDiffPath)
+	// nsrestore runs in the placeholder's mount namespace. Use that exact
+	// image's tar so extraction remains compatible with older target glibc
+	// versions. The injected tool bundle intentionally stays first in PATH and
+	// LD_LIBRARY_PATH for CRIU after this child exits, but the target tar must
+	// not load the bundle's newer shared-library closure.
+	targetTar := filepath.Join(targetRoot, "bin", "tar")
+	log.Info("Applying rootfs diff", "target", targetRoot, "tar", targetTar)
+	cmd := exec.Command(targetTar, "--skip-old-files", "-C", targetRoot, "-xf", rootfsDiffPath)
+	cmd.Env = environmentWithout(os.Environ(), "LD_LIBRARY_PATH")
@@ -180,0 +188,14 @@ func ApplyRootfsDiff(checkpointPath, targetRoot string, log logr.Logger) error {
+// environmentWithout returns a child-process environment with every exact
+// KEY entry removed. It never mutates the current process environment: CRIU
+// therefore retains the injected bundle's PATH and LD_LIBRARY_PATH.
+func environmentWithout(environment []string, key string) []string {
+	prefix := key + "="
+	result := make([]string, 0, len(environment))
+	for _, entry := range environment {
+		if !strings.HasPrefix(entry, prefix) {
+			result = append(result, entry)
+		}
+	}
+	return result
+}
