+func installTargetTarShim(t *testing.T, targetRoot, receiptPath string) {
+	t.Helper()
+	binDir := filepath.Join(targetRoot, "bin")
+	if err := os.MkdirAll(binDir, 0755); err != nil {
+		t.Fatalf("mkdir target bin: %v", err)
+	}
+	script := `#!/bin/sh
+if env | grep -q '^LD_LIBRARY_PATH='; then
+  echo inherited-library-path >&2
+  exit 97
+fi
+printf '%s\n' "$PATH" > "$TARGET_TAR_RECEIPT"
+exec /bin/tar "$@"
+`
+	if err := os.WriteFile(filepath.Join(binDir, "tar"), []byte(script), 0755); err != nil {
+		t.Fatalf("write target tar shim: %v", err)
+	}
+	t.Setenv("TARGET_TAR_RECEIPT", receiptPath)
+}
