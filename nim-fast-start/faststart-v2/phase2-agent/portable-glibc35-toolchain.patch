+# =============================================================================
+# Stage: injected-bundle GLIBC compatibility gate
+# =============================================================================
+# The audit runs in the pinned Jammy CRIU builder, which already carries
+# readelf through build-essential. The final agent copies the receipt from this
+# stage, making the all-ELF GLIBC ceiling a mandatory build dependency without
+# shipping binutils in the runtime image.
+FROM criu-builder AS bundle-glibc35-audit
+COPY --from=agent_pre_unverified /snapshot-binaries /snapshot-binaries
+COPY --chmod=0755 scripts/verify-bundle-glibc.sh /usr/local/bin/verify-bundle-glibc
+RUN /usr/local/bin/verify-bundle-glibc \
+      /snapshot-binaries 2.35 /snapshot-binaries.glibc-compatibility
+
+# This is the common audited base for the compliance and task-local targets.
+FROM agent_pre_unverified AS agent_pre
