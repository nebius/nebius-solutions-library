diff --git a/deploy/snapshot/Dockerfile b/deploy/snapshot/Dockerfile
index 0de9166..c7af2b2 100644
--- a/deploy/snapshot/Dockerfile
+++ b/deploy/snapshot/Dockerfile
@@ -79,6 +79,7 @@ ARG TARGETARCH=amd64
 
 RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-w -s" -o /snapshot-agent ./cmd/agent
 RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-w -s" -o /nsrestore ./cmd/nsrestore
+RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-w -s" -o /restore-worker ./cmd/restore-worker
 
 # Emit a CycloneDX SBOM for snapshot-agent's Go module set. nsrestore's
 # deps are a subset of agent's, so a single SBOM keyed on ./cmd/agent is
@@ -235,6 +236,7 @@ RUN chmod +x /usr/local/sbin/cuda-checkpoint /usr/local/bin/cuda-checkpoint-help
 
 # Copy the built binaries
 COPY --from=builder /snapshot-agent /usr/local/bin/snapshot-agent
+COPY --from=builder /restore-worker /usr/local/bin/restore-worker
 
 # Assemble the injection bundle: bind-mounted read-only into the placeholder's
 # mount namespace at /tmp/snapshot-binaries during restore (internal/nsmount).
@@ -295,6 +297,15 @@ RUN set -eu; \
       fi; \
     done
 
+# Deterministic inventory outside the injected tree. The one-shot worker binds
+# the SHA-256 of this file and verifies every listed file plus the absence of
+# unlisted files before it touches the target runtime.
+RUN cd /snapshot-binaries \
+    && find . -type f -print0 \
+    | sort -z \
+    | xargs -0 sha256sum > /snapshot-binaries.manifest \
+    && test -s /snapshot-binaries.manifest
+
 # Create directories
 RUN mkdir -p /checkpoints /var/run/snapshot
 
