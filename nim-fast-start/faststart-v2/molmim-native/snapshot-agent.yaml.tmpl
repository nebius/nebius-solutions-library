apiVersion: v1
kind: Pod
metadata:
  name: molmim-native-f7-snapshot-agent-t12
  namespace: nim-fast-start
  labels:
    app.kubernetes.io/name: molmim
    app.kubernetes.io/component: snapshot-agent
    app.kubernetes.io/part-of: archvteams-2407-faststart
spec:
  serviceAccountName: archvteams-2407-native-snapshot
  automountServiceAccountToken: true
  enableServiceLinks: false
  restartPolicy: Never
  runtimeClassName: nvidia
  hostPID: true
  hostIPC: true
  hostNetwork: true
  nodeSelector:
    kubernetes.io/hostname: gpu-node-b.example.invalid
  tolerations:
    - operator: Exists
  imagePullSecrets:
    - name: archvteams-2407-registry-pull
  initContainers:
    - name: deploy-seccomp
      image: docker.io/library/busybox:1.36@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - |
          set -eu
          config_sha=$(sha256sum /snapshot-config/config.yaml)
          test "${config_sha%% *}" = e1eeddafb76c80cf19b78dd17cf524da331d8d9a18df235108d58087ab6f9ccf
          seccomp_sha=$(sha256sum /seccomp-profiles/block-iouring.json)
          test "${seccomp_sha%% *}" = ebbe5e221b6b331bb84efbdfea7adb88e9dddab62a2ea901598bad09fe7f76a0
          test ! -e /validated-config/config.yaml
          cp /snapshot-config/config.yaml /validated-config/config.yaml
          chmod 0444 /validated-config/config.yaml
          cmp /snapshot-config/config.yaml /validated-config/config.yaml
          mkdir -p /host-seccomp/profiles
          cp /seccomp-profiles/block-iouring.json /host-seccomp/profiles/block-iouring.json
          chmod 0644 /host-seccomp/profiles/block-iouring.json
          cmp /seccomp-profiles/block-iouring.json /host-seccomp/profiles/block-iouring.json
      securityContext:
        privileged: false
        allowPrivilegeEscalation: false
        capabilities:
          drop:
            - ALL
      volumeMounts:
        - name: config-source
          mountPath: /snapshot-config
          readOnly: true
        - name: config
          mountPath: /validated-config
        - name: seccomp-profiles
          mountPath: /seccomp-profiles
          readOnly: true
        - name: host-seccomp
          mountPath: /host-seccomp
  containers:
    - name: agent
      image: @@WORKER_IMAGE@@
      imagePullPolicy: IfNotPresent
      args:
        - --runtime
        - containerd
        - --runtime-socket
        - /run/containerd/containerd.sock
      env:
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        - name: SNAPSHOT_LOG_LEVEL
          value: info
        - name: RESTRICTED_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          cpu: "4"
          memory: 4Gi
      securityContext:
        privileged: true
      volumeMounts:
        - name: config
          mountPath: /etc/snapshot
          readOnly: true
        - name: checkpoints
          mountPath: /checkpoints
        - name: runtime-run
          mountPath: /run/containerd
        - name: kubelet-pods
          mountPath: /var/lib/kubelet/pods
          readOnly: true
        - name: runtime-storage
          mountPath: /var/lib/containerd
          readOnly: true
        - name: host-proc
          mountPath: /host/proc
        - name: host-cgroup
          mountPath: /sys/fs/cgroup
        - name: kubelet-pod-resources
          mountPath: /var/lib/kubelet/pod-resources
          readOnly: true
  volumes:
    - name: config-source
      configMap:
        name: archvteams-2407-native-snapshot-config
    - name: config
      emptyDir:
        sizeLimit: 1Mi
    - name: seccomp-profiles
      configMap:
        name: archvteams-2407-native-snapshot-seccomp
    - name: host-seccomp
      hostPath:
        path: /var/lib/kubelet/seccomp
        type: DirectoryOrCreate
    - name: checkpoints
      persistentVolumeClaim:
        claimName: molmim-native-f7-artifacts
    - name: runtime-run
      hostPath:
        path: /run/containerd
        type: Directory
    - name: kubelet-pods
      hostPath:
        path: /var/lib/kubelet/pods
        type: Directory
    - name: runtime-storage
      hostPath:
        path: /var/lib/containerd
        type: Directory
    - name: host-proc
      hostPath:
        path: /proc
        type: Directory
    - name: host-cgroup
      hostPath:
        path: /sys/fs/cgroup
        type: Directory
    - name: kubelet-pod-resources
      hostPath:
        path: /var/lib/kubelet/pod-resources
        type: Directory
