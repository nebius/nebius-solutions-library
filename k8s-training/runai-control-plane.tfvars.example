# CPU-only control cluster/state; supply tenant_id, parent_id, subnet_id
# and iam_token externally. The complete Marketplace app is a separate step.
cluster_name               = "runai-control"
region                     = "eu-north1"
k8s_version                = "1.35"
ssh_public_key             = { path = "~/.ssh/id_ed25519.pub" }
cpu_nodes_platform         = "cpu-d3"
cpu_nodes_preset           = "8vcpu-32gb"
cpu_nodes_fixed_count      = 3
cpu_disk_size              = 128
cpu_nodes_public_ips       = false
gpu_node_groups            = 0
gpu_nodes_driverfull_image = true
custom_driver              = false
infiniband_fabric          = ""
enable_grafana             = false
enable_prometheus          = false
enable_nebius_o11y_agent   = false
loki                       = { enabled = false }
network_operator_values    = <<-YAML
  operator:
    deployCR: false
  nfd:
    enabled: false
    deployNodeFeatureRules: false
  sriovNetworkOperator:
    enabled: false
  maintenanceOperator:
    enabled: false
YAML
# Install the complete Run:ai application separately through Marketplace Console/API.
# That graph owns PostgreSQL, credentials, TLS and its generated public URL.
enable_runai = false
