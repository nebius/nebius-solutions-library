users:
  - name: ${ssh_user_name}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

package_upgrade: true
package_update: true
packages:
  - curl
  - jq

write_files:
  - content: |
      AllowUsers ${ssh_user_name}
      AllowUsers ubuntu
      AllowTcpForwarding yes
      PermitTunnel yes
      GatewayPorts yes
      PermitRootLogin no
      Banner none
    path: /etc/ssh/sshd_config.d/65-bastion-settings.conf
    permissions: "644"
    owner: root:root
  - content: |
      #!/bin/bash
      cat <<'EOF'

       	██╗    ██╗███████╗██████╗ ██╗██╗   ██╗███████╗
      	████╗  ██║██╔════╝██╔══██╗██║██║   ██║██╔════╝
      	██╔██╗ ██║█████╗  ██████╔╝██║██║   ██║███████╗
      	██║╚██╗██║██╔══╝  ██╔══██╗██║██║   ██║╚════██║
      	██║ ╚████║███████╗██████╔╝██║╚╗████╔╝ ███████║
      	╚═╝  ╚═══╝╚══════╝╚═════╝ ╚═╝ ╚════╝  ╚══════╝
      EOF
    path: /etc/update-motd.d/01-nebius
    permissions: "0755"
    owner: root:root

runcmd:
  - echo "### Install Nebius CLI" >> /tmp/cloud-init.log 2>&1
  - su - ${ssh_user_name} -c 'export HOME=/home/${ssh_user_name}' >> /tmp/cloud-init.log 2>&1
  - su - ${ssh_user_name} -c 'curl -sSL https://storage.eu-north1.nebius.cloud/cli/install.sh | bash' >> /tmp/cloud-init.log 2>&1
  - su - ${ssh_user_name} -c 'source "/home/${ssh_user_name}/.bashrc"' >> /tmp/cloud-init.log 2>&1
  
  - echo "### Nebius CLI profile create" >> /tmp/cloud-init.log 2>&1
  - su - ${ssh_user_name} -c '/home/${ssh_user_name}/.nebius/bin/nebius profile create --endpoint api.eu.nebius.cloud --token-file /mnt/cloud-metadata/token --profile default --parent-id ${parent_id}' >> /tmp/cloud-init.log 2>&1

  - echo "### Get Tailscale Auth Key" >> /tmp/cloud-init.log 2>&1
  - export TAILSCALE_AUTH_KEY=$(nebius mysterybox payload get --secret-id ${mysterybox_secret_id} --format json | jq -r '.data[] | .string_value')

  - echo "### Install Tailscale from official repo" >> /tmp/cloud-init.log 2>&1
  - sudo mkdir -p --mode=0755 /usr/share/keyrings
  - curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
  - curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list | sudo tee /etc/apt/sources.list.d/tailscale.list >/dev/null
  - sudo apt-get update >> /tmp/cloud-init.log 2>&1
  - sudo apt-get install -y "tailscale=${tailscale_version}" >> /tmp/cloud-init.log 2>&1
  - sudo systemctl enable tailscaled >> /tmp/cloud-init.log 2>&1

   # Configuring firewall
  - sudo ufw allow 40000/udp
  - sudo ufw allow 41641/udp
  - sudo ufw allow 3478/udp
  - sudo ufw allow 80/tcp
  - sudo ufw allow 443/tcp
  - sudo ufw allow OpenSSH
  - sudo ufw disable
  - sudo ufw enable

  # start tailscale peer-relay
  - sudo tailscale up --auth-key=$TAILSCALE_AUTH_KEY >> /tmp/cloud-init.log 2>&1
  - sudo tailscale set --relay-server-port=${tailscale_relay_server_port} >> /tmp/cloud-init.log 2>&1
