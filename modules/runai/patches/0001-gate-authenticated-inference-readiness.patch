 	)
+
+	DescribeTable("requires the model and OAuth listener to be ready before queue-proxy admits traffic",
+		func(modelHealthy, proxyListening, expectedReady bool) {
+			model := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				if !modelHealthy {
+					w.WriteHeader(http.StatusServiceUnavailable)
+				}
+			}))
+			DeferCleanup(model.Close)
+			proxy, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			Expect(err).NotTo(HaveOccurred())
+			proxyPort := proxy.Addr().(*net.TCPAddr).Port
+			if proxyListening {
+				DeferCleanup(func() { Expect(proxy.Close()).To(Succeed()) })
+			} else {
+				Expect(proxy.Close()).To(Succeed())
+			}
+
+			testPorts := map[int]int{8080: model.Listener.Addr().(*net.TCPAddr).Port, 4180: proxyPort}
+			remapPort := func(port intstr.IntOrString) intstr.IntOrString {
+				testPort, ok := testPorts[port.IntValue()]
+				Expect(ok).To(BeTrue(), "unexpected composed readiness port %s", port.String())
+				return intstr.FromInt(testPort)
+			}
+			var probes []*corev1.Probe
+			for _, container := range composeAuthenticatedNIMInference(true).Service.Spec.Template.Spec.Containers {
+				if container.ReadinessProbe == nil {
+					continue
+				}
+				probe := container.ReadinessProbe.DeepCopy()
+				probe.PeriodSeconds, probe.TimeoutSeconds = 1, 1
+				// Knative targets localhost; preserve each composed probe's destination.
+				switch {
+				case probe.HTTPGet != nil:
+					probe.HTTPGet.Host = "127.0.0.1"
+					if probe.HTTPGet.Scheme == "" {
+						probe.HTTPGet.Scheme = corev1.URISchemeHTTP
+					}
+					probe.HTTPGet.Port = remapPort(probe.HTTPGet.Port)
+				case probe.TCPSocket != nil:
+					probe.TCPSocket.Host = "127.0.0.1"
+					probe.TCPSocket.Port = remapPort(probe.TCPSocket.Port)
+				default:
+					Fail("authenticated NIM readiness must use HTTP or TCP")
+				}
+				probes = append(probes, probe)
+			}
+			Expect(readiness.NewProbe(probes).ProbeContainer()).To(Equal(expectedReady))
+		},
+		Entry("both are ready", true, true, true),
+		Entry("healthy model cannot hide a late OAuth listener", true, false, false),
+		Entry("OAuth listener cannot hide an unhealthy model", false, true, false),
+		Entry("neither is ready", false, false, false),
+	)
 })
 
+func composeAuthenticatedNIMInference(serviceSpecLabelsSupported bool) *inference_workloads.KnativeServiceTarget {
+	GinkgoHelper()
+	spec := authenticatedNIMInferenceSpec()
+	infComposer := inference_workloads.NewInferenceToKnativeComposer(
+		"my-llm", "team-a", "runai-team-a", "tester", nil,
+		composer.FieldsComposerOptions{WorkloadV2ServiceSpecLabelsSupported: serviceSpecLabelsSupported},
+	).WithClusterStorageConfig(inferenceOAuth2ContractConfig())
+	target := inference_workloads.NewMinimalKnativeServiceTarget()
+	Expect(infComposer.Compose(context.Background(), convutils.Ref(spec), target)()).To(BeNil())
+	return target
+}
