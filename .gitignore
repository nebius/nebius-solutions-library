# Local .terraform directories
**/.terraform/*

# Terraform lockfile
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*
*.tfplan

# Local credentials generated by k8s-training deployment helpers
**/grafana_access_token.txt

**/*.log

# Exclude all .tfvars files, which are likely to contain sentitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
#*.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Zip archive
*.zip

# DS_Store
.DS_Store

*.pem
# Public certificate fixtures for offline trust regression tests.
!/k8s-inference/tests/ca-trust/*.pem

# Local variables for the core Terraform examples; commit .example files instead.
/k8s-training/terraform.tfvars
/vm-instance/terraform.tfvars
/dsvm/terraform.tfvars
/bastion/terraform.tfvars
/wireguard/terraform.tfvars

# IDE
.idea

# Ignore Soperator installations in commits to this repo.
# It's added to the root .gitignore because they shouldn't be ignored if commited to other repos.
/soperator/installations/*
!/soperator/installations/example

# Python test bytecode
__pycache__/
