# Mk8s cluster name. By default it is "runai"
cluster_name = "runai"

# SSH config
ssh_user_name = "ubuntu" # Username you want to use to connect to the nodes
# Public key for node access: either paste a single-line OpenSSH key below, or
# point 'path' at a key file (defaults to ~/.ssh/id_rsa.pub if both are unset).
ssh_public_key = {
  # key  = "ssh-ed25519 AAAA... user@host"
  # path = "~/.ssh/id_rsa.pub"
}

# K8s nodes
cpu_nodes_fixed_count = 3 # System nodes running the Run:ai control plane
gpu_nodes_fixed_count = 1 # GPU nodes for Run:ai workloads

# Run:ai control plane
runai_version = "2.26.50"

# Helm install/upgrade wait timeout in seconds for all helm releases. The
# Run:ai control plane can take ~15 minutes to become ready — the previous
# 900s default had zero headroom.
# helm_timeout = 2400

# NGC API key for helm repo auth and the nvcr.io pull secret.
# Prefer an environment variable over this file:
#   export TF_VAR_ngc_api_key="..."
# ngc_api_key = "..."

# Initial admin credentials (UI is served at https://runai.<domain>)
runai_admin_username = "admin@runai.local"
# Password must be >= 8 chars with upper+lower+digit+special (-!@#$%^&*()_+=).
# Prefer an environment variable:
#   export TF_VAR_runai_admin_password="..."
# runai_admin_password = "..."

# TLS: "self-signed" (default) auto-generates a cert and derives
# runai.<ingress-lb-ip>.sslip.io DNS. "byo" requires the three variables below.
tls_mode = "self-signed"
# tls_mode = "byo"
# runai_domain = "example.com"            # UI at https://runai.example.com
# tls_certificate = "-----BEGIN CERTIFICATE-----\n..."
# tls_private_key = "-----BEGIN PRIVATE KEY-----\n..."

# Phase 2: register this cluster's GPU pool to the control plane.
# Values are generated by the Run:ai UI onboarding wizard
# (Cluster setup -> Connect a new cluster -> Helm).
runai_cluster_enabled = false
# runai_control_plane_url    = "https://runai.example.com"
# runai_cluster_uid          = "..."
# runai_cluster_url          = "..."
# runai_cluster_client_secret = "..."

# --- Security / network posture ---
# Kubernetes version is pinned to "1.36" by default; it must stay within the
# Run:ai support matrix (1.34-1.36 for Run:ai 2.26, see variables.tf).
# k8s_version = "1.36"

# Public IPv4 addresses on nodes are OFF by default; nodes should be reached
# via a bastion instead. Note the default Nebius public-IPv4 quota is 3 per
# region (also consumed by the HAProxy LB and the mk8s endpoint IP).
# cpu_nodes_public_ips = false
# gpu_nodes_public_ips = false

# CIDRs allowed to reach the mk8s API public endpoint. Per Nebius semantics,
# null/empty leaves the endpoint open to the world — setting this is
# strongly recommended, e.g.:
# mk8s_allowed_cidrs = ["203.0.113.0/24"]

# Add the node-group service account to the tenant 'editors' group. Only
# enable if image pulls or node operations fail without it (least-privilege
# default: false).
# node_group_sa_editors = false
