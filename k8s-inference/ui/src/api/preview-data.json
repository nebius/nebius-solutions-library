    {
      "id": "container-run",
      "name": "Container job (generic run class)",
      "description": "Run any container image with a command on 0-8 GPUs; inputs synced from a bucket prefix to /work/in, everything written under /work is uploaded to the operation's output prefix; /work is a per-operation volume that survives spot interruptions (checkpoint under /work/checkpoint, resume automatically or with :resume). Fine-tuning, data processing, custom simulations.",
      "modes": [
        "run"
      ],
      "default_mode": "run",
      "gpu": "0-8x h100/rtx-pro-6000/l40s",
      "price": "$1.6 / gpu-hour",
      "price_per_call": null,
      "image": null,
      "protocol": "kubernetes-job",
      "cold_start_s": null,
      "cold_start_class": null,
      "parameters": [
        {
          "name": "scratch",
          "type": "string",
          "label": "Scratch storage",
          "default": "network",
          "help": "network = per-run network volume (resumes after preemption); local-nvme = host NVMe of the node (fastest, gone with the pod, checkpoint to the bucket yourself)"
        },
        {
          "name": "image",
          "type": "string",
          "label": "Container image",
          "required": true,
          "help": "registry.serverless2.local/<nvcr|ghcr|docker|quay|k8s|nebius>/<path> goes through the regional cache (docs/IMAGES.md); any public reference also works"
        },
        {
          "name": "command",
          "type": "string",
          "label": "Command",
          "required": true,
          "help": "run with /bin/sh -c inside /work; checkpoint under /work/checkpoint, write results under /work/out"
        },
        {
          "name": "args",
          "type": "text",
          "label": "Arguments",
          "default": [],
          "help": "JSON array of command arguments"
        },
        {
          "name": "env",
          "type": "text",
          "label": "Environment variables",
          "default": {},
          "help": "JSON object of environment names and string values"
        },
        {
          "name": "gpus",
          "type": "number",
          "label": "GPUs",
          "default": 1
        },
        {
          "name": "cpu",
          "type": "string",
          "label": "CPU request",
          "default": "8"
        },
        {
          "name": "memory",
          "type": "string",
          "label": "Memory",
          "default": "64Gi"
        },
        {
          "name": "disk_gi",
          "type": "number",
          "label": "Work volume (GiB)",
          "default": 100
        },
        {
          "name": "input_prefix",
          "type": "string",
          "label": "Input prefix (s3://<tenant bucket>/...)",
          "default": "",
          "help": "optional; synced to /work/in before the first attempt"
        }
      ],
      "endpoints": {},
      "task": "generic",
      "managed_by": "catalog",
      "spec": null,
      "regions": [
        {
          "region": "eu-north1",
          "status": "ready"
        },
        {
          "region": "eu-south1",
          "status": "ready"
        }
      ]
    },
    {
      "id": "distributed-run",
      "name": "Multi-node container job (JobSet; InfiniBand optional)",
      "description": "Run any container image on N whole GPU nodes at once (one pod per node, torchrun/NCCL conventions, MASTER_ADDR/NODE_RANK/WORLD_SIZE set); optionally only on InfiniBand-connected nodes with the fabric NICs in the pod. Inputs synced from a bucket prefix to /work/in on every node, rank 0 uploads /work/out; any node loss restarts all ranks from the last checkpoint (/work/checkpoint, on the shared filesystem with checkpoints=shared). Large-model pre-training and fine-tuning, multi-node inference benchmarks.",
      "modes": [
        "run"
      ],
      "default_mode": "run",
      "gpu": "8x h100/h200/b200/b300",
      "price": "$2.15 / gpu-hour",
      "price_per_call": null,
      "image": null,
      "protocol": "kubernetes-job",
      "cold_start_s": null,
      "cold_start_class": null,
      "parameters": [
        {
          "name": "image",
          "type": "string",
          "label": "Container image",
          "required": true,
          "help": "registry.serverless2.local/<nvcr|ghcr|docker|quay|k8s|nebius>/<path> goes through the regional cache (docs/IMAGES.md)"
        },
        {
          "name": "command",
          "type": "string",
          "label": "Command",
          "required": true,
          "help": "run with /bin/sh -c on every node; use $MASTER_ADDR $MASTER_PORT $NODE_RANK $NNODES $GPUS_PER_NODE $WORLD_SIZE (torchrun --nnodes=$NNODES --node_rank=$NODE_RANK --master_addr=$MASTER_ADDR ...); checkpoint under $CHECKPOINT_DIR, results under /work/out on rank 0"
        },
        {
          "name": "nodes",
          "type": "number",
          "label": "Nodes",
          "default": 2
        },
        {
          "name": "gpus_per_node",
          "type": "number",
          "label": "GPUs per node",
          "default": 8,
          "help": "a whole node: the pool's preset GPU count"
        },
        {
          "name": "interconnect",
          "type": "string",
          "label": "Interconnect",
          "default": "required",
          "help": "required (default: InfiniBand pools only, the pod gets every fabric NIC of its node, NCCL_IB_HCA=mlx5) | preferred (InfiniBand when free, else any whole-node pool) | none (NCCL over TCP: explicit opt-in, useless for large models)"
        },
        {
          "name": "checkpoints",
          "type": "string",
          "label": "Checkpoints",
          "default": "local",
          "help": "local (node scratch, lost on restart) | shared (the tenant's RWX claim on the cluster's shared filesystem: restarts and :resume continue from it)"
        },
        {
          "name": "cpu",
          "type": "string",
          "label": "CPU request per node",
          "default": "96"
        },
        {
          "name": "memory",
          "type": "string",
          "label": "Memory per node",
          "default": "1200Gi"
        },
        {
          "name": "disk_gi",
          "type": "number",
          "label": "Scratch per node (GiB)",
          "default": 500
        },
        {
          "name": "input_prefix",
          "type": "string",
          "label": "Input prefix (s3://<tenant bucket>/...)",
          "default": "",
          "help": "optional; synced to /work/in on every node before the first attempt"
        }
      ],
      "endpoints": {},
