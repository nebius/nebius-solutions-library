#!/bin/sh
# Docker credential helper: `get` prints a fresh IAM token for the registry host on stdin,
# using the profile sa-<region> that ops-login.sh created from the mounted SA key.
# crane re-invokes the helper when the registry answers 401, so copies longer than a token lifetime work.
case "${1:-}" in
  get) host=$(cat); region=$(echo "$host" | sed -n 's/^cr\.\([a-z0-9-]*\)\.nebius\.cloud.*/\1/p')
       tok=$(nebius --profile "sa-$region" iam get-access-token) || exit 1
       printf '{"ServerURL":"%s","Username":"iam","Secret":"%s"}\n' "$host" "$tok" ;;
  *) exit 0 ;;
esac
