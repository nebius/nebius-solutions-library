# K8s job template for MoE (Mixture of Experts) straggler-detection validation.
# Variables substituted by run_moe_k8s.sh via envsubst before kubectl apply.
# Required env vars: JOB_RUN_NAME TRAIN_STEPS TRAIN_PORT TRAIN_NUM_NODES
#   TRAIN_GPUS VM_URL_SVC PIN_MODE SLEEP_MS TARGET_RANKS
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_RUN_NAME}
  namespace: straggler-detection
  labels:
    straggler.nebius.ai/component: training
    straggler.nebius.ai/run: ${JOB_RUN_NAME}
    straggler.nebius.ai/workload: moe
spec:
  completions: ${TRAIN_NUM_NODES}
  parallelism: ${TRAIN_NUM_NODES}
  completionMode: Indexed
  backoffLimit: 0
  template:
    metadata:
      labels:
        straggler.nebius.ai/component: training
        straggler.nebius.ai/run: ${JOB_RUN_NAME}
        straggler.nebius.ai/workload: moe
    spec:
      restartPolicy: Never
      subdomain: ${JOB_RUN_NAME}-headless
      tolerations:
        - key: nvidia.com/gpu
          value: "8"
          effect: NoSchedule
      nodeSelector:
        nebius.com/gpu: "true"
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              straggler.nebius.ai/run: ${JOB_RUN_NAME}
      volumes:
        - name: workspace
          persistentVolumeClaim:
            claimName: straggler-workspace
        - name: inspector-dumps
          emptyDir:
            sizeLimit: "10Gi"
        - name: outdir
          emptyDir:
            sizeLimit: "1Gi"
        - name: sys
          hostPath:
            path: /sys
            type: Directory
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "32Gi"
      containers:
        - name: training
          image: nvcr.io/nvidia/pytorch:25.01-py3
          imagePullPolicy: IfNotPresent
          resources:
            requests:
              cpu: "120"
              memory: 400Gi
              ephemeral-storage: "10Gi"
            limits:
              nvidia.com/gpu: ${TRAIN_GPUS}
              ephemeral-storage: "15Gi"
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: inspector-dumps
              mountPath: /inspector-dumps
            - name: outdir
              mountPath: /outdir
            - name: sys
              mountPath: /sys
              readOnly: true
            - name: dshm
              mountPath: /dev/shm
          env:
            - name: TRAINING_NUM_NODES
              value: "${TRAIN_NUM_NODES}"
            - name: TRAINING_RDZV_HOST
              value: "${JOB_RUN_NAME}-0.${JOB_RUN_NAME}-headless.straggler-detection.svc.cluster.local"
            - name: TRAINING_GPUS_PER_NODE
              value: "${TRAIN_GPUS}"
            - name: TRAINING_NCCL_LIB_PATH
              value: "${NCCL_LIB_PATH}"
            - name: NCCL_INSPECTOR_DUMP_DIR
              value: /inspector-dumps
            - name: PIN_MODE
              value: "${PIN_MODE}"
            # NCCL_IB_DISABLE: NOT set for MoE. MoE creates ONE NCCL process group
            # (init_process_group() once, zero new_group() calls — same structure as FSDP).
            # The HPC-X SHARP plugin loads and uses IB/RDMA safely for a single communicator.
            # The ncclIbDeregMr segfault is specific to Megatron's concurrent multi-group
            # teardown; confirmed absent for MoE's single-communicator pattern (IB smoke test
            # EXIT=0 with recv-wait ~33µs = real RDMA, not TCP's ~1200µs baseline).
            # Keeping RDMA is essential for detection quality: IB gives z≈-8 to -13,
            # TCP gives z≈-2.2 (DESIGN_NOTES §6.42).
            # sleep-before-backward fault injection (WRONG for MoE — sleep runs after
            # the AllToAll in forward, so the AllToAll never sees the straggler signal).
            # Use MOE_FAULT_TARGET_RANK + MOE_FAULT_DELAY_US instead (see below).
            - name: STRAGGLER_SLEEP_MS
              value: "${SLEEP_MS}"
            - name: STRAGGLER_TARGET_RANKS
              value: "${TARGET_RANKS}"
            # AllToAll-targeted fault injection (CORRECT for MoE):
            # Delay injected INSIDE model_moe.py's MoEMLP.forward(), immediately before
            # the dist_nn_func.all_to_all_single() dispatch call. This creates a straggler
            # signal in the AllToAll collective that the tiered check can detect.
            # Set MOE_FAULT_TARGET_RANK=N and MOE_FAULT_DELAY_US=100000 (100ms).
            - name: MOE_FAULT_TARGET_RANK
              value: "${MOE_FAULT_TARGET_RANK}"
            - name: MOE_FAULT_DELAY_US
              value: "${MOE_FAULT_DELAY_US}"
            - name: NCCL_INSPECTOR_DUMP_VERBOSE
              value: "0"
          command:
            - bash
            - -c
            - |
              set -e
              exec bash /workspace/nebius-solutions-library/soperator-straggler-detection/detection-pipeline/workloads/moe/train_node_moe_k8s.sh \
                ${TRAIN_STEPS} /outdir ${TRAIN_PORT} /inspector-dumps
        - name: aggregator
          image: python:3.11-slim
          imagePullPolicy: IfNotPresent
          resources:
            requests:
              cpu: "2"
              memory: 4Gi
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: inspector-dumps
              mountPath: /inspector-dumps
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: VM_URL
              value: "http://${VM_URL_SVC}"
          command:
            - bash
            - -c
            - |
              set -e
              _AGGSCRIPT=/workspace/nebius-solutions-library/soperator-straggler-detection/detection-pipeline/k8s/run_aggregator_k8s.sh
              for i in $(seq 1 30); do [ -f "$_AGGSCRIPT" ] && break; echo "[aggregator] waiting ($i/30)"; sleep 5; done
              exec bash "$_AGGSCRIPT" /inspector-dumps "http://${VM_URL_SVC}" "${JOB_RUN_NAME}"
