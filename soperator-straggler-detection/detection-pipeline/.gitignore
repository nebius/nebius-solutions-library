# Generated by install.sh at run time from real, live cluster discovery --
# never hand-edited, never the same across two different clusters, so
# never committed.
cluster.env
var/

# Build artifacts -- this package's own established convention is to
# build these from source at install time, never ship them precompiled
# (see README.md's "Requirements" section and inspector-plugin/'s own
# already-excluded version.cc for why).
inspector-plugin/libnccl-profiler-inspector.so
inspector-plugin/version.cc
workloads/moe/qp_rate_limit_shim.so

# vm-setup.sh's own real, downloaded binary + live time-series data --
# same "fetch/generate at setup time, never commit" convention as above
# (see vm-standalone/README.md's own "do not copy an existing
# storageDataPath to a new cluster" warning for why the data dir
# specifically must never be committed/shared across clusters).
vm-standalone/victoria-metrics-prod
vm-standalone/data/

# grafana-setup.sh's own real, downloaded release + generated config +
# live sqlite/data -- same convention as vm-standalone above (custom.ini
# embeds a real generated admin password, never meant to be committed;
# the version-numbered release dir is fetched fresh, not vendored).
grafana-standalone/grafana-v*/
grafana-standalone/custom.ini
grafana-standalone/data/

__pycache__/
*.pyc
